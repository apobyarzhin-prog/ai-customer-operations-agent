APP_NAME="AI Customer Operations Agent"
# PostgreSQL example. Keep credentials in the hosting provider's secret store.
DATABASE_URL="postgresql+psycopg://app_user:replace-me@db.example.com:5432/customer_operations"
# Generate a long random value; never use this example in production.
AUTH_SECRET="replace-with-a-long-random-production-secret"
AUTH_TOKEN_EXPIRE_MINUTES="30"
DEMO_AUTH_ENABLED="false"
DEMO_USER_EMAIL=""
DEMO_USER_PASSWORD=""
# Comma-separated browser origins, with no trailing slash.
CORS_ORIGINS="https://app.example.com"
